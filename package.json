{
    "name": "Glue",
    "version": "0.2.28",
    "author": "hackolade",
    "engines": {
        "hackolade": "6.9.11",
        "hackoladePlugin": "1.2.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "Glue",
            "title": "AWS Glue Data Catalog",
            "versions": [
                "2.x",
                "3.x"
            ]
        },
        "features": {
            "nestedCollections": false,
            "disablePatternField": false,
            "enableForwardEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "excel": true,
                "plugin": true,
                "dbt": true
            },
            "disableMultipleTypes": false,
            "enableReverseEngineering": true,
            "disableChoices": false,
            "enableJsonType": true,
            "FEScriptCommentsSupported": [
                {
                    "supportedFETargets": [
                        "hiveQl"
                    ]
                }
            ],
            "enableKeysMultipleAbrr": true,
            "discoverRelationships": true
        }
    },
    "description": "Hackolade plugin for AWS Glue Data Catalog",
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.1",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "17.0.7",
        "oxlint": "1.70.0",
        "oxlint-tsgolint": "0.23.0",
        "prettier": "3.8.4",
        "simple-git-hooks": "2.13.1"
    },
    "dependencies": {
        "@aws-sdk/client-glue": "3.1045.0",
        "@aws-sdk/xml-builder": "3.972.22",
        "@hackolade/fetch": "1.1.0",
        "antlr4": "4.8.0",
        "lodash": "4.18.1"
    },
    "overrides": {
        "minimatch": "10.2.6",
        "fast-xml-parser": "5.7.3",
        "yauzl": "3.2.1",
        "brace-expansion": "5.0.9"
    }
}
